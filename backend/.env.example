MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devsync?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
PORT=5000

# Notes:
# - Copy this file to `backend/.env` and replace placeholder values with real credentials.
# - Do NOT commit `backend/.env` to version control. `.gitignore` already excludes it.